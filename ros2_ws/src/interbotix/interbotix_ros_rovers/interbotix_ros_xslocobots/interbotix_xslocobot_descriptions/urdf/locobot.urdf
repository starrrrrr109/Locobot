  <!-- base_type == 'kobuki' -->
  <!-- base_type == 'create3' -->
  <!-- ****************************** Locobot AprilTag ****************************** -->
  <!--
    AprilTag board mounted on the Locobot.
    Board size: 120 x 120 x 10 mm. The frame origin is at the board center.
    Measured tag center height is 1.42 m above the floor; since
    ${robot_name}/base_link is 0.0102 m above ${robot_name}/base_footprint,
    the tag center is 1.4098 m above ${robot_name}/base_link.
    The tag is 0.10 m to the camera's right (-Y in base_link coordinates) and
    faces 90 degrees clockwise from the camera/base forward direction.
  -->
  <joint name="apriltag_joint" type="fixed">
    <origin rpy="0 0 -1.57079632679" xyz="0 -0.101445 1.4098"/>
    <parent link="locobot/base_link"/>
    <child link="locobot/apriltag_link"/>
  </joint>
  <link name="locobot/apriltag_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.01 0.12 0.12"/>
      </geometry>
      <material name="apriltag_board_white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.01 0.12 0.12"/>
      </geometry>
    </collision>
  </link>
  <!-- ********************************** Camera Tower **********************************  -->
  <!-- base_type == 'kobuki' && camera_tower_size == 'large' -->
  <joint name="camera_tower" type="fixed">
    <origin rpy="0 0 0" xyz="-0.023997 -0.000044 0.08823"/>
    <parent link="locobot/base_link"/>
    <child link="locobot/camera_tower_link"/>
