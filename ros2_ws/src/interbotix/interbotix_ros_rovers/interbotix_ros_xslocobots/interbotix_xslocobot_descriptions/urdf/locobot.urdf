      </geometry>
      <material name="interbotix_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://interbotix_xslocobot_descriptions/meshes/locobot_meshes/kobuki_version/locobot_camera_tower_small_simple.stl" scale="0.001 0.001 0.001"/>
