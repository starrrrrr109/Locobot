FROM osrf/ros:humble-desktop-full

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    nlohmann-json3-dev \
    ros-humble-hardware-interface \
    ros-humble-moveit-ros-move-group \
    ros-humble-moveit-kinematics \
    ros-humble-moveit-planners \
    ros-humble-moveit-simple-controller-manager \
    ros-humble-joint-state-publisher \
    ros-humble-joint-state-publisher-gui \
    ros-humble-xacro \
    ros-humble-controller-manager \
    ros-humble-moveit-configs-utils \
    ros-humble-moveit-ros-visualization \
    ros-humble-moveit-setup-assistant \
    ros-humble-ros2-controllers \
    ros-humble-rosbridge-server \
    ros-humble-rosbridge-suite \
    ros-humble-realsense2-camera \
    ros-humble-realsense2-description \
    ros-humble-ecl-linear-algebra \
    ros-humble-kobuki-ros-interfaces \
    ros-humble-kobuki-core \
    ros-humble-graph-msgs \
    ros-humble-irobot-create-description \
    ros-humble-irobot-create-msgs \
    python3-rosdep \
    python3-colcon-common-extensions \
    python3-pip \
    curl wget gnupg2 lsb-release \
    nano vim git build-essential \
    x11-apps \
    iputils-ping \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install modern_robotics six transforms3d

# ---- Intel RealSense SDK 2.0 (librealsense2) - Built from source ----
# We build from source to get version 2.56.1 which matches realsense-ros branch 4.56.1.
# WARNING: This step requires significant RAM (>8GB recommended) during build.
ENV LIBREALSENSE_VERSION=2.56.1
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl-dev libusb-1.0-0-dev libgtk-3-dev libglfw3-dev \
    libgl1-mesa-dev libglu1-mesa-dev at libudev-dev \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch v${LIBREALSENSE_VERSION} \
    https://github.com/IntelRealSense/librealsense.git /tmp/librealsense && \
    mkdir -p /tmp/librealsense/build && \
    cd /tmp/librealsense/build && \
    cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_EXAMPLES=OFF -DBUILD_GRAPHICAL_EXAMPLES=OFF .. && \
    make -j$(($(nproc) > 2 ? $(nproc) - 2 : 1)) && \
    make install && \
    ldconfig && \
    rm -rf /tmp/librealsense

# 第 1 步：下載原始碼
RUN mkdir -p /interbotix_ws/src && \
    cd /interbotix_ws/src && \
    git clone -b humble --recursive https://github.com/Interbotix/interbotix_ros_core.git && \
    git clone -b humble https://github.com/Interbotix/interbotix_ros_rovers.git && \
    git clone -b humble https://github.com/Interbotix/interbotix_ros_toolboxes.git && \
    git clone -b ros2 https://github.com/ros-planning/moveit_visual_tools.git && \
    git clone https://github.com/Slamtec/sllidar_ros2.git

# 第 2 步：清除會互相衝突或是依賴 ROS 1 的無用套件與解除屏蔽
RUN cd /interbotix_ws/src && \
    rm interbotix_ros_core/interbotix_ros_xseries/COLCON_IGNORE || true && \
    rm interbotix_ros_toolboxes/interbotix_xs_toolbox/COLCON_IGNORE || true && \
    rm interbotix_ros_toolboxes/interbotix_perception_toolbox/COLCON_IGNORE || true && \
    rm interbotix_ros_toolboxes/interbotix_common_toolbox/interbotix_moveit_interface/COLCON_IGNORE || true && \
    rm interbotix_ros_toolboxes/interbotix_common_toolbox/interbotix_moveit_interface_msgs/COLCON_IGNORE || true && \
    rm -rf interbotix_ros_rovers/interbotix_ros_xslocobots/interbotix_xslocobot_moveit_interface \
           interbotix_ros_rovers/interbotix_ros_xslocobots/interbotix_xslocobot_perception \
           interbotix_ros_rovers/interbotix_ros_xslocobots/interbotix_xslocobot_landmark_nav || true

# 第 3 步：安裝 rosdep 依賴
RUN cd /interbotix_ws && \
    apt-get update && \
    rosdep init || true && \
    rosdep update && \
    rosdep install --from-paths src --ignore-src -y --rosdistro humble \
        --skip-keys="interbotix_xs_driver interbotix_xs_msgs interbotix_xs_sdk sllidar_ros2 rospy catkin interbotix_xslocobot_gazebo trossen_slate moveit_visual_tools" || true

# 第 4 步：編譯工作區 (Colcon Build)
RUN /bin/bash -c "source /opt/ros/humble/setup.bash && cd /interbotix_ws && colcon build"

# 設定自動載入環境變數
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc
RUN echo "if [ -f /interbotix_ws/install/setup.bash ]; then source /interbotix_ws/install/setup.bash; fi" >> /root/.bashrc
RUN echo "if [ -f /workspace/ros2_ws/install/setup.bash ]; then source /workspace/ros2_ws/install/setup.bash; fi" >> /root/.bashrc

WORKDIR /workspace
